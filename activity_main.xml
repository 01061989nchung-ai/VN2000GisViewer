<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A">

    <!-- Bảng điều khiển phía trên: Chọn Tỉnh/Thành (Kinh tuyến trục VN-2000), Ảnh Google các năm và Kéo tham chiếu -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/topControlPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hệ tọa độ Quốc gia VN-2000 (Kinh tuyến trục 63 Tỉnh/Thành)"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spinnerProvince"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="2dp"
                android:background="@android:drawable/btn_dropdown" />

            <!-- Chọn múi chiếu 3 độ hoặc 6 độ -->
            <RadioGroup
                android:id="@+id/radioGroupZone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radioZone3Deg"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Múi 3° (k0 = 0.9999)"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />

                <RadioButton
                    android:id="@+id/radioZone6Deg"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="Múi 6° (k0 = 0.9996)"
                    android:textColor="#E2E8F0"
                    android:textSize="11sp" />
            </RadioGroup>

            <!-- Hàng chọn Năm ảnh Google Earth / Wayback + Nút lùi/tiến năm & Thanh trượt độ mờ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPrevYear"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="&lt;"
                    android:textColor="#FACC15"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerSatelliteYear"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1.35"
                    android:background="@android:drawable/btn_dropdown" />

                <Button
                    android:id="@+id/btnNextYear"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:padding="0dp"
                    android:text="&gt;"
                    android:textColor="#FACC15"
                    android:textSize="13sp" />

                <SeekBar
                    android:id="@+id/seekBarSatOpacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="0.65"
                    android:max="255"
                    android:progress="220" />
            </LinearLayout>

            <!-- Hàng công cụ Kéo tham chiếu ảnh Google Earth về VN-2000 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchDragCalibrate"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:layout_weight="1"
                    android:checked="false"
                    android:text="Kéo tham chiếu Google -> VN2000"
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnResetCalibration"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Đặt lại ΔX,ΔY"
                    android:textAllCaps="false"
                    android:textColor="#F87171"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Hàng nút chọn file DGN V8, GeoTIFF, +Ảnh Google, Toàn khung và Vị trí hiện tại (GPS) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickDgn"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:backgroundTint="#2563EB"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:text=".DGN V8"
                    android:textAllCaps="false"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnPickGeoTiff"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="0.9"
                    android:backgroundTint="#059669"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:text=".TIFF"
                    android:textAllCaps="false"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnPickGooglePhoto"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1.15"
                    android:backgroundTint="#D97706"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:text="+Ảnh Google"
                    android:textAllCaps="false"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnMyLocation"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1.1"
                    android:backgroundTint="#0284C7"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:text="Vị trí (GPS)"
                    android:textAllCaps="false"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnFitBounds"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="0.95"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="2dp"
                    android:text="Toàn khung"
                    android:textAllCaps="false"
                    android:textColor="#F8FAFC"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Hàng công tắc Bật/Tắt từng lớp (Google Earth, DGN, TIFF, Lưới VN-2000) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchLayerSatellite"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Google"
                    android:textColor="#FACC15"
                    android:textSize="11sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchLayerDgn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="DGN"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchLayerTiff"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="TIFF"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchGrid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Lưới"
                    android:textColor="#F1F5F9"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Khung vẽ Bản đồ GIS (Chồng lớp Google Earth các năm + GeoTIFF + Vector DGN V8 + Vị trí GPS) -->
    <vn.gis.vn2000viewer.ui.MapCanvasView
        android:id="@+id/mapCanvasView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomHudCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topControlPanel" />

    <!-- Thanh trạng thái tải tệp lớn (<100MB) bất đồng bộ trên Dispatchers.IO -->
    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:background="#D90F172A"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/mapCanvasView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mapCanvasView">

        <ProgressBar
            android:id="@+id/progressBarLoading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#38BDF8" />

        <TextView
            android:id="@+id/tvProgressStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Đang xử lý dữ liệu GIS..."
            android:textColor="#F8FAFC"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bảng thông tin tọa độ VN-2000 (X, Y) trực tiếp khi chạm vào bản đồ hoặc định vị GPS -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomHudCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvCoordinateOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Chạm bản đồ hoặc bấm [Vị trí (GPS)] để xem tọa độ X, Y chuẩn VN-2000"
                android:textColor="#FACC15"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLayerSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="DGN: Chưa nạp tệp (.dgn)"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvRasterSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GeoTIFF: Chưa nạp tệp (.tif / .tiff)"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvViewportStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Độ phân giải: -- m/px | Hiển thị: 0 đối tượng"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvProj4Definition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="#64748B"
                android:textSize="10sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
